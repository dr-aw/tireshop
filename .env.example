# Optional host-side override; contains a path, never the password itself.
# Relative paths are resolved from the main Compose file's directory.
POSTGRES_PASSWORD_PATH=../tireshop-secrets/postgres_password
CATALOG_PASSWORD_PATH=../tireshop-secrets/catalog_password
REQUESTS_PASSWORD_PATH=../tireshop-secrets/requests_password
AIVEN_CA_PATH=../tireshop-secrets/ca.pem

# Production runtime only (set on Cloud Run, not in the local Compose env):
# APP_ENV=production
# PGHOST=db.example.com
# PGPORT=5432
# PGDATABASE=shop
# PGUSER=shop_catalog_login
# PGSSLROOTCERT=/etc/tireshop-ca/ca.pem
# CATALOG_PASSWORD_FILE=/etc/tireshop-password/password
# REQUESTS_PASSWORD_FILE=/etc/tireshop-password/password
# PGPOOL_MAX_CONNS=4
# APP_ORIGINS=https://shop.example.com
# HTTP_ADDR=0.0.0.0:10000
