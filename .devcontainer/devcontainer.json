{
  "name": "tireshop-dev",
  "dockerComposeFile": ["../compose.yaml", "../compose.dev-ca.yaml"],
  "service": "dev",
  "workspaceFolder": "/workspace",
  "shutdownAction": "stopCompose",
  "remoteUser": "vscode",
  "forwardPorts": [5173],
  "postCreateCommand": "bash .devcontainer/setup-dev.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go",
        "oven.bun-vscode",
        "dbaeumer.vscode-eslint"
      ]
    }
  }
}
